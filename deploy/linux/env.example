# Configuration for UploadGuard, installed as /opt/uploadguard/.env
# Everything the service needs lives in /opt/uploadguard.

# Internal base URL of the storage backend, no trailing slash. Required.
UPSTREAM_URL=http://127.0.0.1:3900

# Port UploadGuard listens on. The reverse proxy forwards the upload subdomain here.
PORT=8080

# There is no list of accepted media types here. The content type travels inside the presigned
# signature, so it is decided by whatever issues those URLs and enforced by the storage backend.
# UploadGuard only checks that the body is what the declared Content-Type says it is.
